#import <WebGL/Types.idl>

// https://registry.khronos.org/webgl/extensions/WEBGL_color_buffer_float/
// The title-cased interface name remains private because
// LegacyNoInterfaceObject keeps extension names out of the global namespace.
[Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface WebGLColorBufferFloat {
    const GLenum RGBA32F_EXT = 0x8814;
    const GLenum FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE_EXT = 0x8211;
    const GLenum UNSIGNED_NORMALIZED_EXT = 0x8C17;
};
