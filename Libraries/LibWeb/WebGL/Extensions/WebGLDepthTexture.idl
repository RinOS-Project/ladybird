#import <WebGL/Types.idl>

// https://registry.khronos.org/webgl/extensions/WEBGL_depth_texture/
// The title-cased interface name is intentionally distinct from the extension
// string, as LegacyNoInterfaceObject keeps it out of the JS global scope.
[Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface WebGLDepthTexture {
    const GLenum UNSIGNED_INT_24_8_WEBGL = 0x84FA;
};
