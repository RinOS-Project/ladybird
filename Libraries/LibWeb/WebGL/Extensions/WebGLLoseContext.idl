// https://registry.khronos.org/webgl/extensions/WEBGL_lose_context/
// The C++ spelling intentionally uses title case; LegacyNoInterfaceObject
// keeps this implementation detail out of the JavaScript global namespace.
[Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface WebGLLoseContext {
    undefined loseContext();
    undefined restoreContext();
};
